# ========================================================
# Backend Environment Configuration
# ========================================================

# --- Database Settings (MySQL / TiDB / Aiven / Railway) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=student_results

# Alternatively, specify a single cloud connection URI:
# DATABASE_URL=mysql://username:password@hostname:3306/student_results

# Optional SSL CA certificate path if required by cloud provider
# DB_SSL_CA=/path/to/ca.pem

# --- SMTP Email Dispatch Configuration ---
# Generate an App Password in your Google Account: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password

# --- Server & Security Settings ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# --- OCR / Binary Paths (Optional, automatically detected on Linux/Docker) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
